{
  "uid": "de32-chat-monitoring",
  "title": "De32 Chat Monitoring",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "tags": [
    "de32",
    "monitoring"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Targets UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Container CPU (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",image!=\"\"}[1m])) * 100",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Container RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{job=\"cadvisor\",image!=\"\"})",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Container network receive",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\",image!=\"\"}[1m]))",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Container network transmit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",image!=\"\"}[1m]))",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "PostgreSQL UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{job=\"postgres\",datname=\"chatdb\"}",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Nginx active connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active{job=\"nginx\"}",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Nginx requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total{job=\"nginx\"}[1m])",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(chat_http_requests_total{job=\"chat-app\"}[1m]))",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "HTTP duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(chat_http_request_duration_seconds_bucket{job=\"chat-app\"}[1m])))",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Socket.IO connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "chat-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "chat_socketio_connections{job=\"chat-app\"}",
          "legendFormat": "{{name}}{{route}}{{job}}",
          "range": true
        }
      ]
    }
  ]
}
